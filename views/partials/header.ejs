<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> · Travel Companion</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="<%= currentUser ? '/dashboard' : '/' %>">
        <span class="brand-mark">✈</span>
        <span class="brand-text">Travel Companion</span>
      </a>
      <nav class="nav">
        <a href="/posts">Experiences</a>
        <% if (currentUser) { %>
          <a href="/matchmaking">Matchmaking</a>
          <a href="/itineraries">Itineraries</a>
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin">Admin</a>
          <% } %>
          <span class="nav-user">@<%= escapeHtml(currentUser.username) %></span>
          <form class="inline" action="/logout" method="POST">
            <button type="submit" class="btn btn-ghost btn-sm">Logout</button>
          </form>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="btn btn-primary btn-sm" href="/register">Sign up</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="container main">
    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>" role="alert"><%= escapeHtml(flash.message) %></div>
    <% } %>
